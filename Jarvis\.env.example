# ============================================================
# Jarvis — Asistente Financiero Personal de Diego Rodriguez
# Copiá este archivo como .env y completá los valores
# ============================================================


# --- NOTICIAS (capas opcionales — enriquecen Yahoo Finance) ---

# Alpha Vantage — RECOMENDADO — hasta 1 año de historia + sentimiento por artículo
# Gratis en: https://www.alphavantage.co/support/#api-key
# Plan gratuito: 25 requests/día (suficiente para uso diario)
# Con esta key, Jarvis puede analizar noticias de los últimos 6 meses de cualquier empresa
ALPHA_VANTAGE_KEY=

# NewsAPI — opcional — últimos 30 días, fuentes periodísticas
# Gratis en: https://newsapi.org (500 requests/día)
NEWSAPI_KEY=


# --- EMAIL (para envío de reportes) ---
#
# OPCIÓN A: Gmail con Contraseña de Aplicación (recomendado)
# Pasos para obtener la contraseña de aplicación:
#   1. Ir a https://myaccount.google.com/security
#   2. Activar "Verificación en dos pasos" si no está activa
#   3. Ir a "Contraseñas de aplicaciones"
#   4. Crear una nueva: seleccionar "Correo" y "Windows"
#   5. Copiar la contraseña de 16 caracteres generada (sin espacios)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Email de destino de los reportes (el de Diego)
JARVIS_EMAIL_TO=diego@email.com

# Email desde donde se manda (puede ser el mismo que SMTP_USER)
JARVIS_EMAIL_FROM=tu_email@gmail.com

#
# OPCIÓN B: Resend (más simple para dominio propio — https://resend.com)
# Gratis hasta 3000 emails/mes. Descomentar y completar si se usa esta opción.
# RESEND_API_KEY=re_xxxxxxxxxx
# JARVIS_EMAIL_FROM=jarvis@tudominio.com


# --- ZONA HORARIA ---
TZ=America/Argentina/Buenos_Aires
