//@version=5
strategy("XAU/USD - Price Action M3 Strategy",
         overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         initial_capital=10000,
         commission_type=strategy.commission.cash_per_order,
         commission_value=0.2)

// ─── INPUTS ────────────────────────────────────────────────────────────────────
var bool  SHOW_LEVELS   = input.bool(true,  "Mostrar niveles M3")
var bool  SHOW_LABELS   = input.bool(true,  "Mostrar etiquetas")
var float RR            = input.float(0.9,  "Risk/Reward ratio", step=0.1)
var int   MAX_SL_PIPS   = input.int(200,    "SL máximo (pips)")
var int   DAILY_SL_MAX  = input.int(2,      "Stop diario (max SL)")
var float WEEKLY_R_MAX  = input.float(-2.0, "Stop semanal (R)")
var float MIN_BODY_PCT  = input.float(0.50, "Mínimo cuerpo vela (%)", step=0.05)
var float BREAKOUT_PCT  = input.float(0.01, "Mínimo quiebre (%)", step=0.01) / 100

// ─── SESIÓN NY ─────────────────────────────────────────────────────────────────
sess = time(timeframe.period, "0901-1059", "America/New_York")
inSession = not na(sess)

// ─── FUNCIONES DE VELA ────────────────────────────────────────────────────────
bodySize(o, h, l, c) => math.abs(c - o)
totalSize(h, l)      => h - l
bodyPct(o, h, l, c)  => totalSize(h,l) > 0 ? bodySize(o,h,l,c) / totalSize(h,l) : 0

isBullish(o, c) => c > o
isBearish(o, c) => c < o
hasVolume(o, h, l, c) => bodyPct(o, h, l, c) >= MIN_BODY_PCT

// ─── DETECCIÓN ALTO Y BAJO M3 ──────────────────────────────────────────────────
// Alto m3: vela alcista [1] seguida de vela bajista [0]
// Bajo m3: vela bajista [1] seguida de vela alcista [0]

isAltoM3 = isBullish(open[1], close[1]) and isBearish(open, close)
isBajoM3 = isBearish(open[1], close[1]) and isBullish(open, close)

var float altoM3Level = na
var float bajoM3Level = na
var int   altoM3Bar   = na
var int   bajoM3Bar   = na

if isAltoM3
    altoM3Level := high[1]
    altoM3Bar   := bar_index - 1

if isBajoM3
    bajoM3Level := low[1]
    bajoM3Bar   := bar_index - 1

// ─── VISUALIZACIÓN DE NIVELES ──────────────────────────────────────────────────
plotshape(SHOW_LEVELS and isAltoM3, title="Alto M3",
          location=location.abovebar, style=shape.triangledown,
          color=color.new(color.red, 0), size=size.tiny, offset=-1)

plotshape(SHOW_LEVELS and isBajoM3, title="Bajo M3",
          location=location.belowbar, style=shape.triangleup,
          color=color.new(color.green, 0), size=size.tiny, offset=-1)

// Línea del último alto m3
var line lineAlto = na
var line lineBajo = na

if isAltoM3 and SHOW_LEVELS
    if not na(lineAlto)
        line.delete(lineAlto)
    lineAlto := line.new(bar_index-1, high[1], bar_index+20, high[1],
                          color=color.new(color.red, 30), width=1,
                          style=line.style_dashed)

if isBajoM3 and SHOW_LEVELS
    if not na(lineBajo)
        line.delete(lineBajo)
    lineBajo := line.new(bar_index-1, low[1], bar_index+20, low[1],
                          color=color.new(color.green, 30), width=1,
                          style=line.style_dashed)

// ─── DETECCIÓN DE VELA ENVOLVENTE ─────────────────────────────────────────────
// Envolvente alcista: cierra por encima del high anterior y tiene volumen
engulfingBull = isBullish(open, close) and hasVolume(open, high, low, close) and close > high[1] and bodyPct(open, high, low, close) >= MIN_BODY_PCT

// Envolvente bajista: cierra por debajo del low anterior y tiene volumen
engulfingBear = isBearish(open, close) and hasVolume(open, high, low, close) and close < low[1] and bodyPct(open, high, low, close) >= MIN_BODY_PCT

// ─── GESTIÓN DE RIESGO DIARIA Y SEMANAL ───────────────────────────────────────
var int   dailySL      = 0
var float weeklyR      = 0.0
var int   lastTradeDay = na
var int   lastTradeWk  = na

currentDay  = dayofmonth
currentWeek = weekofyear

// Reset diario
if currentDay != lastTradeDay
    dailySL     := 0
    lastTradeDay := currentDay

// Reset semanal
if currentWeek != lastTradeWk
    weeklyR     := 0.0
    lastTradeWk  := currentWeek

// ─── CONDICIONES DE TRADING ───────────────────────────────────────────────────
canTrade = inSession and dailySL < DAILY_SL_MAX and weeklyR > WEEKLY_R_MAX and strategy.position_size == 0

// ─── MODELO MEC — ENTRADA LARGO ───────────────────────────────────────────────
// Quiebre del alto m3 con volumen + vela envolvente alcista
mecLong = canTrade and not na(altoM3Level) and close > altoM3Level * (1 + BREAKOUT_PCT) and engulfingBull

if mecLong
    slDist  = math.min(altoM3Level - low, MAX_SL_PIPS * syminfo.mintick * 10)
    slPrice = close - slDist
    tpPrice = close + slDist * RR

    strategy.entry("LONG", strategy.long, comment="MEC Long")
    strategy.exit("SL/TP Long", "LONG", stop=slPrice, limit=tpPrice)

    if SHOW_LABELS
        label.new(bar_index, low - (high-low)*0.5,
                  "▲ MEC L\nE:" + str.tostring(math.round(close,2)) +
                  "\nSL:" + str.tostring(math.round(slPrice,2)) +
                  "\nTP:" + str.tostring(math.round(tpPrice,2)),
                  color=color.new(color.green, 20),
                  textcolor=color.white, size=size.small,
                  style=label.style_label_up)

// ─── MODELO MEC — ENTRADA CORTO ───────────────────────────────────────────────
// Quiebre del bajo m3 con volumen + vela envolvente bajista
mecShort = canTrade and not na(bajoM3Level) and close < bajoM3Level * (1 - BREAKOUT_PCT) and engulfingBear

if mecShort
    slDist  = math.min(high - bajoM3Level, MAX_SL_PIPS * syminfo.mintick * 10)
    slPrice = close + slDist
    tpPrice = close - slDist * RR

    strategy.entry("SHORT", strategy.short, comment="MEC Short")
    strategy.exit("SL/TP Short", "SHORT", stop=slPrice, limit=tpPrice)

    if SHOW_LABELS
        label.new(bar_index, high + (high-low)*0.5,
                  "▼ MEC S\nE:" + str.tostring(math.round(close,2)) +
                  "\nSL:" + str.tostring(math.round(slPrice,2)) +
                  "\nTP:" + str.tostring(math.round(tpPrice,2)),
                  color=color.new(color.red, 20),
                  textcolor=color.white, size=size.small,
                  style=label.style_label_down)

// ─── MODELO MER — ENTRADA LARGO (Retroceso) ───────────────────────────────────
// La vela misma quiebra el bajo m3 hacia arriba con envolvente
merLong = canTrade and not na(bajoM3Level) and low < bajoM3Level and close > bajoM3Level and engulfingBull and not mecLong

if merLong
    slDist  = math.min(high - low, MAX_SL_PIPS * syminfo.mintick * 10)
    slPrice = low - syminfo.mintick
    tpPrice = close + slDist * RR

    strategy.entry("LONG_R", strategy.long, comment="MER Long")
    strategy.exit("SL/TP LongR", "LONG_R", stop=slPrice, limit=tpPrice)

// ─── MODELO MER — ENTRADA CORTO (Retroceso) ───────────────────────────────────
merShort = canTrade and not na(altoM3Level) and high > altoM3Level and close < altoM3Level and engulfingBear and not mecShort

if merShort
    slDist  = math.min(high - low, MAX_SL_PIPS * syminfo.mintick * 10)
    slPrice = high + syminfo.mintick
    tpPrice = close - slDist * RR

    strategy.entry("SHORT_R", strategy.short, comment="MER Short")
    strategy.exit("SL/TP ShortR", "SHORT_R", stop=slPrice, limit=tpPrice)

// ─── TRACKING DE RESULTADOS ───────────────────────────────────────────────────
if strategy.closedtrades > 0
    lastResult = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastResult < 0
        dailySL  := dailySL + 1
        weeklyR  := weeklyR - 1.0
    else if lastResult > 0
        weeklyR  := weeklyR + RR

// ─── FONDO DE SESIÓN ──────────────────────────────────────────────────────────
bgcolor(inSession ? color.new(color.blue, 95) : na, title="Sesión NY")

// ─── TABLA DE STATS EN VIVO ───────────────────────────────────────────────────
var table statsTable = table.new(position.top_right, 2, 6,
                                  bgcolor=color.new(color.black, 70),
                                  border_color=color.new(color.gray, 50),
                                  border_width=1)

if barstate.islast
    totalTrades = strategy.closedtrades
    wins        = strategy.wintrades
    losses      = strategy.losstrades
    winRate     = totalTrades > 0 ? wins / totalTrades * 100 : 0
    netProfit   = strategy.netprofit

    table.cell(statsTable, 0, 0, "XAU M3 Strategy",    text_color=color.white, bgcolor=color.new(color.blue,50), text_size=size.small)
    table.cell(statsTable, 1, 0, "Stats",               text_color=color.white, bgcolor=color.new(color.blue,50), text_size=size.small)
    table.cell(statsTable, 0, 1, "Total Trades",        text_color=color.gray,  text_size=size.small)
    table.cell(statsTable, 1, 1, str.tostring(totalTrades), text_color=color.white, text_size=size.small)
    table.cell(statsTable, 0, 2, "Win Rate",            text_color=color.gray,  text_size=size.small)
    table.cell(statsTable, 1, 2, str.tostring(math.round(winRate,1)) + "%",
               text_color=winRate >= 55 ? color.green : color.red, text_size=size.small)
    table.cell(statsTable, 0, 3, "Wins / Losses",       text_color=color.gray,  text_size=size.small)
    table.cell(statsTable, 1, 3, str.tostring(wins) + " / " + str.tostring(losses),
               text_color=color.white, text_size=size.small)
    table.cell(statsTable, 0, 4, "Net Profit",          text_color=color.gray,  text_size=size.small)
    table.cell(statsTable, 1, 4, str.tostring(math.round(netProfit,2)),
               text_color=netProfit >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(statsTable, 0, 5, "SL hoy / R semana",  text_color=color.gray,  text_size=size.small)
    table.cell(statsTable, 1, 5, str.tostring(dailySL) + " / " + str.tostring(math.round(weeklyR,1)) + "R",
               text_color=color.white, text_size=size.small)
