//@version=5
strategy("XAU/USD Plan Tecnico", shorttitle="XAU v4", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1, initial_capital=10000, currency=currency.USD, commission_type=strategy.commission.cash_per_contract, commission_value=0, slippage=0, calc_on_every_tick=false, max_bars_back=500)

// BLOQUE 1 - SESION OPERATIVA
// Instrumento : XAUUSD (OANDA) en TradingView
// Timeframe   : M1 (estructura en M3)
// Sesion      : 09:01 - 10:59 hora Nueva York
// America/New_York maneja DST automaticamente
// Verano  (mar-nov): NY=UTC-4, Argentina 10:01-11:59
// Invierno(nov-mar): NY=UTC-5, Argentina 11:01-12:59

in_session = not na(time("1", "0901-1059", "America/New_York"))

bgcolor(in_session ? color.new(color.blue, 90) : na, title="Sesion operativa")

// -----------------------------------------------
// BLOQUE 2 - NIVELES M3
// Alto M3: punto mas alto del fractal (verde + roja + variantes)
// Bajo M3: punto mas bajo del fractal (roja + verde + variantes)
// Variante: si vela adyacente tiene mecha mas extrema, ese es el nivel
// Linea punteada: 8 M3 bars = 24 M1 bars de extension
// -----------------------------------------------

// Pivot M3 con variante automatica
// ta.highest/lowest sobre 4 barras M3 captura el extremo real del fractal
m3_ph_val = request.security(syminfo.tickerid, "3", not na(ta.pivothigh(high, 1, 1)) ? ta.highest(high, 4) : na, lookahead=barmerge.lookahead_off)
m3_pl_val = request.security(syminfo.tickerid, "3", not na(ta.pivotlow(low, 1, 1))  ? ta.lowest(low, 4)   : na, lookahead=barmerge.lookahead_off)

// Guardamos los ultimos 2 altos y 2 bajos M3 (usados en bloques futuros)
var float m3h1 = na
var float m3h2 = na
var float m3l1 = na
var float m3l2 = na

if not na(m3_ph_val)
    m3h2 := m3h1
    m3h1 := m3_ph_val

if not na(m3_pl_val)
    m3l2 := m3l1
    m3l1 := m3_pl_val

// Dibujamos lineas punteadas (solo en barras confirmadas)
// Alto M3: rojo punteado | Bajo M3: teal punteado
// 24 M1 bars = 8 M3 bars de extension
if barstate.isconfirmed
    if not na(m3_ph_val)
        line.new(bar_index, m3_ph_val, bar_index + 24, m3_ph_val, color=color.new(color.red, 30), style=line.style_dotted, width=2)
    if not na(m3_pl_val)
        line.new(bar_index, m3_pl_val, bar_index + 24, m3_pl_val, color=color.new(color.teal, 30), style=line.style_dotted, width=2)

// -----------------------------------------------
// BLOQUE 3 - TENDENCIA M3 Y CAMBIO DE ESTRUCTURA (ChOC)
// Quiebre valido: cuerpo M1 supera nivel M3 en >= 0.01%
// Tendencia: quiebres consecutivos en la misma direccion
// ChOC: primer quiebre en direccion contraria a la tendencia
// Linea continua del ChOC: 8 M1 bars de extension
// -----------------------------------------------

min_brk = 0.0001  // 0.01% minimo de quiebre valido

// Quiebre alcista: close supera ultimo alto M3 con cuerpo >= 0.01%
brk_up = not na(m3h1) and close > m3h1 and (close - m3h1) / m3h1 >= min_brk

// Quiebre bajista: close rompe ultimo bajo M3 con cuerpo >= 0.01%
brk_dn = not na(m3l1) and close < m3l1 and (m3l1 - close) / m3l1 >= min_brk

// Tendencia M3: 1=alcista  -1=bajista  0=sin tendencia aun
var int m3_trend = 0

// ChOC: quiebre en direccion opuesta a la tendencia activa
choc_up   = m3_trend == -1 and brk_up
choc_down = m3_trend ==  1 and brk_dn

// Actualizar tendencia
if brk_up
    m3_trend := 1
if brk_dn
    m3_trend := -1

// Dibujar linea continua en el nivel del ChOC (8 M1 bars)
// Verde = ChOC alcista | Rojo = ChOC bajista
if barstate.isconfirmed
    if choc_up
        line.new(bar_index, m3h1, bar_index + 8, m3h1, color=color.new(color.green, 20), style=line.style_solid, width=2)
    if choc_down
        line.new(bar_index, m3l1, bar_index + 8, m3l1, color=color.new(color.red, 20), style=line.style_solid, width=2)

// -----------------------------------------------
// BLOQUE 4 - TIPOS DE VELA ENVOLVENTE (M1)
// i)  Estandar : cuerpo >= 85% vela actual, mecha opuesta < 15%, close supera high/low[1]
// ii) Martillo : cuerpo 50-85%, mecha extrema > cuerpo, close supera high/low[1]
// iii)Doji     : ambas mechas >= 15% y simetricas, cuerpo <= 50%
//     Excepcion doji: si mecha a favor ~ 0 -> usar reglas estandar
// -----------------------------------------------

// Helpers de tamano de vela
f_total(h, l)     => h - l
f_body(o, c)      => math.abs(c - o)
f_upper(h, o, c)  => h - math.max(o, c)
f_lower(l, o, c)  => math.min(o, c) - l

// Ratios sobre el total de la vela (0.0 a 1.0)
f_br(h, l, o, c)  => f_total(h,l) > 0 ? f_body(o,c)  / f_total(h,l) : 0.0
f_ur(h, l, o, c)  => f_total(h,l) > 0 ? f_upper(h,o,c) / f_total(h,l) : 0.0
f_lr(h, l, o, c)  => f_total(h,l) > 0 ? f_lower(l,o,c) / f_total(h,l) : 0.0

// i) ESTANDAR BUY: cuerpo >= 85%, mecha superior < 15%, close > high[1]
f_std_bull(h, l, o, c) =>
    c > o and f_br(h,l,o,c) >= 0.85 and f_ur(h,l,o,c) < 0.15 and c > h[1]

// i) ESTANDAR SELL: cuerpo >= 85%, mecha inferior < 15%, close < low[1]
f_std_bear(h, l, o, c) =>
    c < o and f_br(h,l,o,c) >= 0.85 and f_lr(h,l,o,c) < 0.15 and c < l[1]

// ii) MARTILLO BUY: cuerpo 50-85%, mecha inferior > cuerpo, close > high[1]
f_hmr_bull(h, l, o, c) =>
    c > o and f_br(h,l,o,c) >= 0.50 and f_br(h,l,o,c) < 0.85 and f_lower(l,o,c) > f_body(o,c) and c > h[1]

// ii) MARTILLO SELL: cuerpo 50-85%, mecha superior > cuerpo, close < low[1]
f_hmr_bear(h, l, o, c) =>
    c < o and f_br(h,l,o,c) >= 0.50 and f_br(h,l,o,c) < 0.85 and f_upper(h,o,c) > f_body(o,c) and c < l[1]

// iii) DOJI BUY: ambas mechas >= 15% y simetricas, cuerpo <= 50%, close > high[1]
// Excepcion: si mecha inferior (a favor) ~ 0 -> usar estandar
f_doji_bull(h, l, o, c) =>
    lr = f_lr(h,l,o,c)
    if lr < 0.05
        f_std_bull(h,l,o,c)
    else
        tot = f_total(h,l)
        sym = tot > 0 ? math.abs(f_lower(l,o,c) - f_upper(h,o,c)) / tot <= 0.30 : false
        cond = c > o and f_br(h,l,o,c) <= 0.50 and lr >= 0.15 and f_ur(h,l,o,c) >= 0.15 and sym and c > h[1]
        cond

// iii) DOJI SELL: excepcion: si mecha superior (a favor) ~ 0 -> usar estandar
f_doji_bear(h, l, o, c) =>
    ur = f_ur(h,l,o,c)
    if ur < 0.05
        f_std_bear(h,l,o,c)
    else
        tot = f_total(h,l)
        sym = tot > 0 ? math.abs(f_lower(l,o,c) - f_upper(h,o,c)) / tot <= 0.30 : false
        cond = c < o and f_br(h,l,o,c) <= 0.50 and f_lr(h,l,o,c) >= 0.15 and ur >= 0.15 and sym and c < l[1]
        cond

// Cualquier vela envolvente valida (los 3 tipos)
f_engulf_bull(h, l, o, c) => f_std_bull(h,l,o,c) or f_hmr_bull(h,l,o,c) or f_doji_bull(h,l,o,c)
f_engulf_bear(h, l, o, c) => f_std_bear(h,l,o,c) or f_hmr_bear(h,l,o,c) or f_doji_bear(h,l,o,c)

// -----------------------------------------------
// BLOQUE 5 - PATRONES DE ENTRADA
// Patron Envolvente: 1+ velas pullback + envolvente que cubre todo el pullback
// Patron START: 1+ pullback + vela indecision mismo color + envolvente
// Invalido START: si entrada es 3ra vela consecutiva del mismo color
// -----------------------------------------------

// Vela de indecision para Patron START
// Doji: cuerpo <= 50%, mechas en ambos extremos, mismo color que entrada
// Pinbar: cuerpo <= 50%, una mecha >= 2x la otra, mismo color que entrada
// Excepcion: si cuerpo supera 50% por solo 0.01% -> valida igual

f_indec_bull(h, l, o, c) =>
    br = f_br(h,l,o,c)
    lw = f_lower(l,o,c)
    uw = f_upper(h,o,c)
    is_green = c > o
    body_ok = br <= 0.5001
    is_doji = body_ok and f_lr(h,l,o,c) > 0.10 and f_ur(h,l,o,c) > 0.10
    is_pinbar = body_ok and (lw >= uw * 2.0 or uw >= lw * 2.0) and br < 0.50
    is_green and (is_doji or is_pinbar)

f_indec_bear(h, l, o, c) =>
    br = f_br(h,l,o,c)
    lw = f_lower(l,o,c)
    uw = f_upper(h,o,c)
    is_red = c < o
    body_ok = br <= 0.5001
    is_doji = body_ok and f_lr(h,l,o,c) > 0.10 and f_ur(h,l,o,c) > 0.10
    is_pinbar = body_ok and (lw >= uw * 2.0 or uw >= lw * 2.0) and br < 0.50
    is_red and (is_doji or is_pinbar)

// PATRON ENVOLVENTE BUY
// 1+ rojas consecutivas (pullback) + envolvente bull que cubre todo
f_pat_env_bull() =>
    if not f_engulf_bull(high, low, open, close)
        false
    else
        pb = 0
        mxH = 0.0
        mnL = 999999.0
        for i = 1 to 10
            if close[i] < open[i]
                pb   := pb + 1
                mxH  := math.max(mxH, high[i])
                mnL  := math.min(mnL, low[i])
            else
                break
        pb > 0 and high > mxH and low < mnL

// PATRON ENVOLVENTE SELL
// 1+ verdes consecutivas (pullback) + envolvente bear que cubre todo
f_pat_env_bear() =>
    if not f_engulf_bear(high, low, open, close)
        false
    else
        pb = 0
        mxH = 0.0
        mnL = 999999.0
        for i = 1 to 10
            if close[i] > open[i]
                pb   := pb + 1
                mxH  := math.max(mxH, high[i])
                mnL  := math.min(mnL, low[i])
            else
                break
        pb > 0 and low < mnL and high > mxH

// PATRON START BUY (Morning Star)
// 1+ rojas + doji/pinbar VERDE + envolvente verde
// Invalido si entrada es 3ra verde consecutiva
f_pat_start_bull() =>
    if close > open and close[1] > open[1] and close[2] > open[2]
        false
    else if not f_engulf_bull(high, low, open, close)
        false
    else if not f_indec_bull(high[1], low[1], open[1], close[1])
        false
    else
        has_red = false
        for i = 2 to 11
            if close[i] < open[i]
                has_red := true
                break
        has_red

// PATRON START SELL (Evening Star)
// 1+ verdes + doji/pinbar ROJA + envolvente roja
// Invalido si entrada es 3ra roja consecutiva
f_pat_start_bear() =>
    if close < open and close[1] < open[1] and close[2] < open[2]
        false
    else if not f_engulf_bear(high, low, open, close)
        false
    else if not f_indec_bear(high[1], low[1], open[1], close[1])
        false
    else
        has_green = false
        for i = 2 to 11
            if close[i] > open[i]
                has_green := true
                break
        has_green

// -----------------------------------------------
// BLOQUE 6 - MODELO MEC (Entrada Continuacion)
// Escenario a: tendencia M3 activa + patron (Envolvente o START)
// Escenario b: ChOC + Quiebre-Pullback-Continuacion (QPC)
//   El ChOC bar = Quiebre
//   Pullback: velas en contra
//   Continuacion: envolvente que supera extremo pre-pullback
//                 y cubre todo el pullback (high>mxH y low<mnL)
// -----------------------------------------------

// QPC State Machine - BUY (despues de choc_up)
var int   qb_st   = 0   // 0=idle 1=post_choc 2=en_pullback
var float qb_preH = na  // extremo maximo antes del pullback
var float qb_pbMH = na  // max high del pullback
var float qb_pbML = na  // min low del pullback

// QPC State Machine - SELL (despues de choc_down)
var int   qs_st   = 0
var float qs_preL = na
var float qs_pbMH = na
var float qs_pbML = na

// Reset en ChOC
if choc_up
    qb_st   := 1
    qb_preH := high
    qb_pbMH := na
    qb_pbML := na
    qs_st   := 0

if choc_down
    qs_st   := 1
    qs_preL := low
    qs_pbMH := na
    qs_pbML := na
    qb_st   := 0

// Maquina de estados BUY QPC
if qb_st == 1 and not choc_up
    if close < open
        qb_st   := 2
        qb_pbMH := high
        qb_pbML := low
    else
        qb_preH := math.max(qb_preH, high)

if qb_st == 2 and close < open
    qb_pbMH := math.max(qb_pbMH, high)
    qb_pbML := math.min(qb_pbML, low)

// Maquina de estados SELL QPC
if qs_st == 1 and not choc_down
    if close > open
        qs_st   := 2
        qs_pbMH := high
        qs_pbML := low
    else
        qs_preL := math.min(qs_preL, low)

if qs_st == 2 and close > open
    qs_pbMH := math.max(qs_pbMH, high)
    qs_pbML := math.min(qs_pbML, low)

// MEC (b): envolvente que cubre pullback Y supera extremo pre-pullback
mec_b_bull = in_session and qb_st == 2 and not na(qb_preH) and not na(qb_pbML) and f_engulf_bull(high, low, open, close) and high > qb_preH and low < qb_pbML
mec_b_bear = in_session and qs_st == 2 and not na(qs_preL) and not na(qs_pbMH) and f_engulf_bear(high, low, open, close) and low < qs_preL and high > qs_pbMH

// Reset QPC tras senal
if mec_b_bull
    qb_st := 0
if mec_b_bear
    qs_st := 0

// MEC (a): tendencia activa + patron en M1
mec_a_bull = in_session and m3_trend == 1 and (f_pat_env_bull() or f_pat_start_bull())
mec_a_bear = in_session and m3_trend == -1 and (f_pat_env_bear() or f_pat_start_bear())

// Senal MEC combinada
mec_bull = mec_a_bull or mec_b_bull
mec_bear = mec_a_bear or mec_b_bear

// Etiquetas visuales BUY/SELL (gris, texto blanco)
// Se muestran ahora, las ordenes se ejecutan en Bloque 8
if barstate.isconfirmed
    if mec_bull
        label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(color.gray, 25), textcolor=color.white, size=size.normal)
    if mec_bear
        label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(color.gray, 25), textcolor=color.white, size=size.normal)

// -----------------------------------------------
// BLOQUE 7 - MODELO MER (Entrada Retroceso)
// Requiere: ChOC valido (ya garantizado por min_brk en Bloque 3)
// Entrada: PRIMERA vela que toca el nivel del ChOC
//   Si cumple parametros de envolvente -> entrada
//   Si NO cumple -> no hay entrada (sin segunda oportunidad)
// Regla adicional: solo 1 nivel M3 opuesto (donde va el SL)
//   Si hay 2 niveles y distancia > 0.01% -> invalido
// -----------------------------------------------

// Guardamos el nivel exacto del ChOC para detectar el primer toque
var float mer_lvl_bull = na   // alto M3 roto en choc_up (retrocede hacia el)
var float mer_lvl_bear = na   // bajo M3 roto en choc_down
var bool  mer_used_bull = false  // primer toque ya consumido
var bool  mer_used_bear = false
var bool  mer_ok_bull   = false  // ChOC valido para MER
var bool  mer_ok_bear   = false

if choc_up
    mer_lvl_bull  := m3h1
    mer_used_bull := false
    mer_ok_bull   := true
    mer_ok_bear   := false
    mer_used_bear := false

if choc_down
    mer_lvl_bear  := m3l1
    mer_used_bear := false
    mer_ok_bear   := true
    mer_ok_bull   := false
    mer_used_bull := false

// Regla: solo 1 nivel M3 opuesto al SL
// BUY: SL va en m3l1 -> si m3l2 existe y distancia > 0.01% -> invalido
one_low_ok  = na(m3l2) or (not na(m3l1) and math.abs(m3l1 - m3l2) / m3l1 <= 0.0001)
one_high_ok = na(m3h2) or (not na(m3h1) and math.abs(m3h1 - m3h2) / m3h1 <= 0.0001)

// Primer toque del nivel ChOC
mer_touch_bull = mer_ok_bull and not mer_used_bull and not na(mer_lvl_bull) and low <= mer_lvl_bull * 1.0005
mer_touch_bear = mer_ok_bear and not mer_used_bear and not na(mer_lvl_bear) and high >= mer_lvl_bear * 0.9995

// Marcar como consumido en el primer toque (valido o no)
if mer_touch_bull
    mer_used_bull := true
if mer_touch_bear
    mer_used_bear := true

// Senal MER: primer toque + envolvente valida + nivel unico opuesto
mer_bull = in_session and mer_touch_bull and f_engulf_bull(high, low, open, close) and one_low_ok
mer_bear = in_session and mer_touch_bear and f_engulf_bear(high, low, open, close) and one_high_ok

// Etiquetas visuales MER (mismo estilo que MEC)
if barstate.isconfirmed
    if mer_bull
        label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(color.gray, 25), textcolor=color.white, size=size.normal)
    if mer_bear
        label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(color.gray, 25), textcolor=color.white, size=size.normal)

// -----------------------------------------------
// BLOQUE 8 - SL, TP, LIMITES DIARIOS Y ORDENES
// SL BUY  : ultimo bajo M3 (m3l1)
// SL SELL : ultimo alto M3 (m3h1)
// Si distancia SL > 20.000 pips -> reducir 40% (quedar con 60%)
// TP: RR 1:0.9
// Limites diarios: 1 TP -> parar | 2 SL -> parar | 1SL+1TP -> parar
// Hedge: senal contraria estando en posicion -> cerrar y abrir nueva
// -----------------------------------------------

// 1 pip XAUUSD OANDA = syminfo.mintick (0.01)
pip = syminfo.mintick

// CALCULO SL
sl_bull_price() =>
    sl_raw = not na(m3l1) ? m3l1 : close - 300 * pip
    dist   = (close - sl_raw) / pip
    dist > 20000 ? close - 20000 * 0.6 * pip : sl_raw

sl_bear_price() =>
    sl_raw = not na(m3h1) ? m3h1 : close + 300 * pip
    dist   = (sl_raw - close) / pip
    dist > 20000 ? close + 20000 * 0.6 * pip : sl_raw

// LIMITES DIARIOS
var int day_sl       = 0
var int day_tp       = 0
var int last_day     = na
var int last_tr_cnt  = 0

curr_day = dayofmonth(time)

if curr_day != last_day
    day_sl      := 0
    day_tp      := 0
    last_tr_cnt := strategy.closedtrades
    last_day    := curr_day

if strategy.closedtrades > last_tr_cnt
    for i = last_tr_cnt to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) >= 0
            day_tp := day_tp + 1
        else
            day_sl := day_sl + 1
    last_tr_cnt := strategy.closedtrades

// Puede operar: 0 TP y menos de 2 SL en el dia
can_trade = day_tp == 0 and day_sl < 2

// SENALES FINALES CON FILTRO DIARIO
sig_bull = (mec_bull or mer_bull) and can_trade
sig_bear = (mec_bear or mer_bear) and can_trade

// HEDGE: senal contraria con posicion abierta -> cerrar y abrir nueva
if strategy.position_size > 0 and (mec_bear or mer_bear) and can_trade
    strategy.close("BUY", comment="HEDGE")
if strategy.position_size < 0 and (mec_bull or mer_bull) and can_trade
    strategy.close("SELL", comment="HEDGE")

// ENTRADA BUY
if sig_bull and strategy.position_size == 0
    sl = sl_bull_price()
    sl := math.min(sl, close - pip * 5)
    tp = close + (close - sl) * 0.9
    lbl = mec_bull ? "MEC" : "MER"
    strategy.entry("BUY", strategy.long, comment=lbl)
    strategy.exit("BUY_X", "BUY", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")

// ENTRADA SELL
if sig_bear and strategy.position_size == 0
    sl = sl_bear_price()
    sl := math.max(sl, close + pip * 5)
    tp = close - (sl - close) * 0.9
    lbl = mec_bear ? "MEC" : "MER"
    strategy.entry("SELL", strategy.short, comment=lbl)
    strategy.exit("SELL_X", "SELL", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")

// -----------------------------------------------
// BLOQUE 9 - DASHBOARD Y ALERTAS
// Panel informativo en tiempo real
// -----------------------------------------------

var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 60), border_color=color.new(color.gray, 40), border_width=1, frame_color=color.new(color.gray, 20), frame_width=1)

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "XAU/USD v4", text_color=color.white, bgcolor=color.new(color.navy, 10), text_size=size.small)
    table.cell(dash, 1, 0, "M1 + M3",    text_color=color.silver, bgcolor=color.new(color.navy, 10), text_size=size.small)

    // Tendencia M3
    tc = m3_trend == 1 ? color.lime : m3_trend == -1 ? color.red : color.gray
    tt = m3_trend == 1 ? "ALCISTA  ▲" : m3_trend == -1 ? "BAJISTA  ▼" : "NEUTRAL"
    table.cell(dash, 0, 1, "Tendencia M3", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, tt, text_color=tc, text_size=size.small)

    // Sesion
    sc = in_session ? color.lime : color.gray
    table.cell(dash, 0, 2, "Sesion NY", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, in_session ? "ACTIVA" : "CERRADA", text_color=sc, text_size=size.small)

    // SL del dia
    slc = day_sl >= 2 ? color.red : day_sl == 1 ? color.yellow : color.lime
    table.cell(dash, 0, 3, "SL hoy", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(day_sl) + " / 2", text_color=slc, text_size=size.small)

    // TP del dia
    tpc = day_tp >= 1 ? color.red : color.lime
    table.cell(dash, 0, 4, "TP hoy", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(day_tp) + " / 1", text_color=tpc, text_size=size.small)

    // Puede operar
    ctc = can_trade ? color.lime : color.red
    table.cell(dash, 0, 5, "Opera hoy", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, can_trade ? "SI" : "NO", text_color=ctc, text_size=size.small)

    // Posicion actual
    pc = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    pt = strategy.position_size > 0 ? "LONG  ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT"
    table.cell(dash, 0, 6, "Posicion", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, pt, text_color=pc, text_size=size.small)

    // Niveles M3
    ht = not na(m3h1) ? str.tostring(m3h1, "#.##") : "---"
    lt = not na(m3l1) ? str.tostring(m3l1, "#.##") : "---"
    table.cell(dash, 0, 7, "Alto / Bajo M3", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, ht + " / " + lt, text_color=color.white, text_size=size.tiny)

// ALERTAS
alertcondition(sig_bull,  "XAU BUY",       "XAUUSD | COMPRA | Precio: {{close}}")
alertcondition(sig_bear,  "XAU SELL",      "XAUUSD | VENTA  | Precio: {{close}}")
alertcondition(choc_up,   "ChOC Alcista",  "XAUUSD | Cambio estructura ALCISTA | {{close}}")
alertcondition(choc_down, "ChOC Bajista",  "XAUUSD | Cambio estructura BAJISTA | {{close}}")
alertcondition(not can_trade and in_session, "Limite Diario", "XAUUSD | LIMITE DIARIO alcanzado")
