//@version=5
strategy("XAU Scalping Strategy", shorttitle="XAU Scalp",
     overlay=true, pyramiding=1,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.35, slippage=1,
     use_bar_magnifier=true, calc_on_every_tick=false, max_bars_back=5000)

// ============================================================
// INPUTS
// ============================================================
i_tz   = input.string("America/New_York", "Zona horaria", group="Sesion")
i_sess = input.string("0901-1059:23456",  "Horario NY",   group="Sesion")
i_ext  = input.int(25,    "Extension lineas m3 (velas m1)", minval=10, maxval=80,  group="Visual")
i_sm3  = input.bool(true, "Mostrar lineas m3",    group="Visual")
i_sse  = input.bool(true, "Sombrear sesion",      group="Visual")
i_ssl  = input.bool(true, "Mostrar SL/TP",        group="Visual")
i_stb  = input.bool(true, "Mostrar tabla stats",  group="Visual")
i_std  = input.float(85.0,"Envolvente std - cuerpo min %", minval=70, maxval=100, group="Patrones m1")
i_ham  = input.float(50.0,"Martillo - cuerpo min %",       minval=30, maxval=84,  group="Patrones m1")
i_hwk  = input.float(40.0,"Martillo - mecha opuesta %",    minval=20, maxval=70,  group="Patrones m1")
i_dwk  = input.float(15.0,"Doji - mecha min por lado %",   minval=5,  maxval=40,  group="Patrones m1")
i_dbd  = input.float(70.0,"Doji - cuerpo max %",           minval=30, maxval=84,  group="Patrones m1")
i_ibd  = input.float(50.0,"Indecision - cuerpo max %",     minval=20, maxval=60,  group="Patrones m1")
i_rr   = input.float(0.9, "RR (TP = SL x RR)", minval=0.1, step=0.1, group="Riesgo")
i_slm  = input.float(20000,"SL max (pips)",     minval=100,            group="Riesgo")

// ============================================================
// FUNCION raiz: segmento horizontal de longitud fija
// ============================================================
f_seg(lvl, col, sty, wdt) =>
    line.new(bar_index, lvl, bar_index + i_ext, lvl,
         xloc=xloc.bar_index, color=col, style=sty, width=wdt)

// ============================================================
// SESION
// ============================================================
in_sess = not na(time(timeframe.period, i_sess, i_tz))
bgcolor(i_sse and in_sess ? color.new(color.blue, 93) : na)

// ============================================================
// DATOS m3 (estructura)
// ============================================================
[h3, l3, c3, o3] = request.security(syminfo.tickerid, "3",
     [high, low, close, open], lookahead=barmerge.lookahead_off)

ph3 = ta.pivothigh(h3, 2, 2)
pl3 = ta.pivotlow (l3, 2, 2)

var float m3h1 = na
var float m3h2 = na
var float m3l1 = na
var float m3l2 = na

if not na(ph3) and ph3 != m3h1
    m3h2 := m3h1
    m3h1 := ph3

if not na(pl3) and pl3 != m3l1
    m3l2 := m3l1
    m3l1 := pl3

// ============================================================
// TENDENCIA m3
// FIX CRITICO: detectar la tendencia comparando pivots
// (nuevo pivot vs pivot anterior) — NO comparar close vs nivel
// Alcista : alto m3 mas alto que el anterior (HH)
// Bajista : alto m3 mas bajo que el anterior (LH)
// ============================================================
var int trend = 0

if not na(ph3) and not na(m3h2)
    if ph3 > m3h2
        trend := 1
    else if ph3 < m3h2
        trend := -1

if not na(pl3) and not na(m3l2)
    if pl3 > m3l2
        trend := 1
    else if pl3 < m3l2
        trend := -1

// ============================================================
// CHoCH — CAMBIO DE ESTRUCTURA
// Cuando el precio rompe el nivel OPUESTO a la tendencia actual
// ============================================================
var bool choch_b = false
var bool choch_s = false
choch_b := false
choch_s := false

pip      = syminfo.mintick
body_min = close * 0.0001

if trend == -1 and not na(m3h1)
    if close > m3h1 and (close - m3h1) >= body_min
        choch_b := true
        trend   := 1

if trend == 1 and not na(m3l1)
    if close < m3l1 and (m3l1 - close) >= body_min
        choch_s := true
        trend   := -1

// Nivel exacto del CHoCH (para MER)
var float clvl_b = na
var float clvl_s = na
var bool  mer_ok = false
var bool  last_ok = false

if choch_b
    clvl_b  := m3h1
    clvl_s  := na
    mer_ok  := last_ok
    last_ok := false
    if i_sm3
        ln = f_seg(m3h1, color.black, line.style_solid, 2)
        array.push(arr_ch, ln)
        if array.size(arr_ch) > 20
            line.delete(array.shift(arr_ch))

if choch_s
    clvl_s  := m3l1
    clvl_b  := na
    mer_ok  := last_ok
    last_ok := false
    if i_sm3
        ln = f_seg(m3l1, color.black, line.style_solid, 2)
        array.push(arr_ch, ln)
        if array.size(arr_ch) > 20
            line.delete(array.shift(arr_ch))

// Quiebres tendenciales validos (para validar MER)
if (trend == 1 and not na(ph3) and ph3 > m3h2) or (trend == -1 and not na(pl3) and pl3 < m3l2)
    last_ok := true

// ============================================================
// LINEAS m3
// ============================================================
var line[] arr_h  = array.new<line>()
var line[] arr_l  = array.new<line>()
var line[] arr_ch = array.new<line>()

if i_sm3
    if not na(ph3) and ph3 != m3h1[1]
        ln = f_seg(ph3, color.black, line.style_dashed, 1)
        array.push(arr_h, ln)
        if array.size(arr_h) > 50
            line.delete(array.shift(arr_h))
    if not na(pl3) and pl3 != m3l1[1]
        ln = f_seg(pl3, color.black, line.style_dashed, 1)
        array.push(arr_l, ln)
        if array.size(arr_l) > 50
            line.delete(array.shift(arr_l))

// ============================================================
// PATRONES DE VELA m1
// ============================================================
rng     = high - low
bdy     = math.abs(close - open)
bpct    = rng > 0 ? bdy / rng * 100.0 : 0.0
uw      = high - math.max(close, open)
lw      = math.min(close, open) - low
upct    = rng > 0 ? uw / rng * 100.0 : 0.0
lpct    = rng > 0 ? lw / rng * 100.0 : 0.0
is_bull = close > open
is_bear = close < open

bull_std = is_bull and bpct >= i_std and lpct < (100.0 - i_std + 5.0)
bear_std = is_bear and bpct >= i_std and upct < (100.0 - i_std + 5.0)
bull_ham = is_bull and bpct >= i_ham and bpct < i_std and lpct >= i_hwk
bear_ham = is_bear and bpct >= i_ham and bpct < i_std and upct >= i_hwk
bull_dji = is_bull and upct >= i_dwk and lpct >= i_dwk and bpct < i_dbd
bear_dji = is_bear and upct >= i_dwk and lpct >= i_dwk and bpct < i_dbd

bull_env = bull_std or bull_ham or bull_dji
bear_env = bear_std or bear_ham or bear_dji

indec = bpct <= i_ibd and (upct >= i_dwk or lpct >= i_dwk) and not (bull_ham or bear_ham)

// Patron Envolvente (cubre 1 o 2 velas de pullback)
bpe1 = bull_env and is_bear[1] and close >= high[1] and open <= low[1]
spe1 = bear_env and is_bull[1] and close <= low[1]  and open >= high[1]
bpe2 = bull_env and is_bear[1] and is_bear[2] and close >= math.max(high[1],high[2]) and open <= math.min(low[1],low[2])
spe2 = bear_env and is_bull[1] and is_bull[2] and close <= math.min(low[1],low[2])   and open >= math.max(high[1],high[2])
bull_pe = bpe1 or bpe2
bear_pe = spe1 or spe2

// Patron START
bull_ps = bull_env and indec[1] and is_bear[2] and not (is_bull and is_bull[1] and is_bull[2])
bear_ps = bear_env and indec[1] and is_bull[2] and not (is_bear and is_bear[1] and is_bear[2])

// ============================================================
// MEC — MODELO ENTRADA CONTINUACION
// A: tendencia activa + patron
// B: CHoCH + QPC (Quiebre-Pullback-Continuacion en m1)
// ============================================================
mec_a_b = trend == 1  and (bull_pe or bull_ps) and in_sess
mec_a_s = trend == -1 and (bear_pe or bear_ps) and in_sess

var int   qst = 0
var int   qdr = 0
var float qrf = na

if choch_b
    qst := 1
    qdr := 1
    qrf := na
if choch_s
    qst := 1
    qdr := -1
    qrf := na

if qst == 1
    if qdr == 1 and is_bear
        qst := 2
        qrf := high
    else if qdr == -1 and is_bull
        qst := 2
        qrf := low

if qst == 2
    if qdr == 1
        if is_bear
            qrf := math.max(na(qrf) ? high : qrf, high)
        else if is_bull and close > qrf
            qst := 3
    else if qdr == -1
        if is_bull
            qrf := math.min(na(qrf) ? low : qrf, low)
        else if is_bear and close < qrf
            qst := 3

mec_b_b = qst == 3 and qdr == 1  and (bull_pe or bull_ps) and in_sess
mec_b_s = qst == 3 and qdr == -1 and (bear_pe or bear_ps) and in_sess

if mec_b_b or mec_b_s or choch_b or choch_s
    qst := 0

mec_b = mec_a_b or mec_b_b
mec_s = mec_a_s or mec_b_s

// ============================================================
// MER — MODELO ENTRADA RETROCESO
// ============================================================
dh    = not na(m3h1) and not na(m3h2) ? math.abs(m3h1-m3h2)/math.max(m3h1,m3h2)*100.0 : 100.0
dl    = not na(m3l1) and not na(m3l2) ? math.abs(m3l1-m3l2)/math.max(m3l1,m3l2)*100.0 : 100.0
one_h = na(m3h2) or dh <= 0.01
one_l = na(m3l2) or dl <= 0.01

var bool arm_b = false
var bool arm_s = false
var bool don_b = false
var bool don_s = false

if choch_b
    arm_b := true
    arm_s := false
    don_b := false
if choch_s
    arm_s := true
    arm_b := false
    don_s := false

touch_b = arm_b and not don_b and not na(clvl_b) and low  <= clvl_b
touch_s = arm_s and not don_s and not na(clvl_s) and high >= clvl_s

mer_b = touch_b and bull_env and one_l and mer_ok and in_sess
mer_s = touch_s and bear_env and one_h and mer_ok and in_sess

if touch_b
    don_b := true
if touch_s
    don_s := true

// ============================================================
// SENALES + LIMITES DIARIOS
// ============================================================
raw_b = mec_b or mer_b
raw_s = mec_s or mer_s

day_id  = year * 10000 + month * 100 + dayofmonth
new_day = ta.change(day_id) != 0

var int dtp = 0
var int dsl = 0
var int dtr = 0

if new_day
    dtp := 0
    dsl := 0
    dtr := strategy.closedtrades

nc = strategy.closedtrades
if nc > dtr
    for i = dtr to nc - 1
        if strategy.closedtrades.profit(i) >= 0
            dtp := dtp + 1
        else
            dsl := dsl + 1
    dtr := nc

stopped = dtp >= 1 or dsl >= 2 or (dsl >= 1 and dtp >= 1)
ok      = in_sess and not stopped

sig_b = raw_b and ok and strategy.position_size == 0
sig_s = raw_s and ok and strategy.position_size == 0
hdg_s = raw_s and ok and strategy.position_size > 0
hdg_b = raw_b and ok and strategy.position_size < 0

// ============================================================
// SL / TP
// ============================================================
f_adj(d) =>
    d / pip > i_slm ? d * 0.6 : d

sld_b = not na(m3l1) ? close - m3l1 : na
sld_s = not na(m3h1) ? m3h1 - close : na
sl_b  = not na(sld_b) ? close - f_adj(sld_b)        : na
tp_b  = not na(sld_b) ? close + f_adj(sld_b) * i_rr : na
sl_s  = not na(sld_s) ? close + f_adj(sld_s)        : na
tp_s  = not na(sld_s) ? close - f_adj(sld_s) * i_rr : na

// ============================================================
// EJECUCION
// ============================================================
if sig_b
    strategy.entry("BUY", strategy.long)
    if not na(sl_b) and not na(tp_b)
        strategy.exit("BUY_X", "BUY", stop=sl_b, limit=tp_b)

if sig_s
    strategy.entry("SELL", strategy.short)
    if not na(sl_s) and not na(tp_s)
        strategy.exit("SELL_X", "SELL", stop=sl_s, limit=tp_s)

if hdg_s
    strategy.close("BUY", comment="Hedge")
    strategy.entry("SELL", strategy.short)
    if not na(sl_s) and not na(tp_s)
        strategy.exit("SELL_X", "SELL", stop=sl_s, limit=tp_s)

if hdg_b
    strategy.close("SELL", comment="Hedge")
    strategy.entry("BUY", strategy.long)
    if not na(sl_b) and not na(tp_b)
        strategy.exit("BUY_X", "BUY", stop=sl_b, limit=tp_b)

if not in_sess and strategy.position_size != 0
    strategy.close_all(comment="Fin sesion")

// ============================================================
// LABELS BUY / SELL
// ============================================================
if (sig_b or hdg_b) and ok
    label.new(bar_index, low, "BUY",
         style=label.style_label_up, color=color.new(color.gray, 30),
         textcolor=color.white, size=size.small, textalign=text.align_center)

if (sig_s or hdg_s) and ok
    label.new(bar_index, high, "SELL",
         style=label.style_label_down, color=color.new(color.gray, 30),
         textcolor=color.white, size=size.small, textalign=text.align_center)

// ============================================================
// SL/TP PLOTS
// ============================================================
plot(i_ssl and strategy.position_size > 0 ? sl_b : na, "SL BUY",  color.red,  2, plot.style_linebr)
plot(i_ssl and strategy.position_size > 0 ? tp_b : na, "TP BUY",  color.lime, 2, plot.style_linebr)
plot(i_ssl and strategy.position_size < 0 ? sl_s : na, "SL SELL", color.red,  2, plot.style_linebr)
plot(i_ssl and strategy.position_size < 0 ? tp_s : na, "TP SELL", color.lime, 2, plot.style_linebr)

// ============================================================
// TABLA
// ============================================================
var table T = table.new(position.top_right, 2, 12,
     bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 50),
     border_width=1, frame_color=color.new(color.gray, 40), frame_width=1)

if i_stb and barstate.islast
    col_h  = color.new(color.navy,   5)
    col_bg = color.new(color.gray,  80)
    col_g  = color.new(color.green, 60)
    col_r  = color.new(color.red,   60)
    col_o  = color.new(color.orange,60)
    col_gy = color.new(color.gray,  60)

    tot  = strategy.closedtrades
    wins = 0
    loss = 0
    gp   = 0.0
    gl   = 0.0
    if tot > 0
        for i = 0 to tot - 1
            p = strategy.closedtrades.profit(i)
            if p >= 0
                wins := wins + 1
                gp   := gp + p
            else
                loss := loss + 1
                gl   := gl + math.abs(p)

    wr  = tot > 0 ? wins / tot * 100.0 : 0.0
    pf  = gl > 0 ? gp / gl : 0.0
    net = strategy.netprofit
    dd  = strategy.max_drawdown

    table.cell(T,0,0,"XAU SCALPING",  text_color=color.white,bgcolor=col_h, text_size=size.small)
    table.cell(T,1,0,"STATS",          text_color=color.white,bgcolor=col_h, text_size=size.small)
    table.cell(T,0,1,"Operaciones",   text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,1,str.tostring(tot),text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,0,2,"Win Rate",      text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,2,str.tostring(wr,"#.##")+"%",text_color=color.white,
         bgcolor=wr>=50?col_g:col_r,text_size=size.small)
    table.cell(T,0,3,"Wins / Losses", text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,3,str.tostring(wins)+" / "+str.tostring(loss),
         text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,0,4,"Profit Factor", text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,4,str.tostring(pf,"#.##"),text_color=color.white,
         bgcolor=pf>=1.5?col_g:col_r,text_size=size.small)
    table.cell(T,0,5,"P&L Neto USD",  text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,5,"$"+str.tostring(net,"#.##"),text_color=color.white,
         bgcolor=net>=0?col_g:col_r,text_size=size.small)
    table.cell(T,0,6,"Max Drawdown",  text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,6,"$"+str.tostring(dd,"#.##"),text_color=color.white,bgcolor=col_o,text_size=size.small)
    table.cell(T,0,7,"Tendencia m3",  text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,7,trend==1?"ALCISTA":trend==-1?"BAJISTA":"NEUTRAL",text_color=color.white,
         bgcolor=trend==1?col_g:trend==-1?col_r:col_gy,text_size=size.small)
    table.cell(T,0,8,"QPC Estado",    text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,8,qst==0?"Inactivo":qst==1?"Quiebre":qst==2?"Pullback":"Continuacion",
         text_color=color.white,bgcolor=qst==3?col_g:qst==2?col_o:col_bg,text_size=size.small)
    table.cell(T,0,9,"MER activo",    text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,9,(arm_b and not don_b)?"BULL":(arm_s and not don_s)?"BEAR":"No",
         text_color=color.white,
         bgcolor=(arm_b and not don_b)?col_g:(arm_s and not don_s)?col_r:col_bg,text_size=size.small)
    table.cell(T,0,10,"TP hoy",       text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,10,str.tostring(dtp),text_color=color.white,
         bgcolor=dtp>0?col_g:col_bg,text_size=size.small)
    table.cell(T,0,11,"SL hoy",       text_color=color.white,bgcolor=col_bg,text_size=size.small)
    table.cell(T,1,11,str.tostring(dsl),text_color=color.white,
         bgcolor=dsl>0?col_r:col_bg,text_size=size.small)
